# 填入配置的 cdn
VITE_CDN_BASE_URL=

# 全站访问统计同源接口；EdgeOne 默认路由为 /api/activity
VITE_ACTIVITY_API_BASE_URL=/api/activity
# 仅服务端使用；在 EdgeOne 项目环境变量中配置，生产与预览必须使用不同名称
# SDK 首次访问时自动创建 Blob 命名空间，无需 KV 绑定或浏览器端密钥
ACTIVITY_BLOB_STORE=xcpc-link-activity-production

# 网站备案信息；配置后会显示在首页页脚
VITE_ICP_LICENSE_NUMBER=
VITE_ICP_LICENSE_URL=https://beian.miit.gov.cn/
VITE_PUBLIC_SECURITY_RECORD_NUMBER=
VITE_PUBLIC_SECURITY_RECORD_URL=https://beian.mps.gov.cn/
